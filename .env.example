# The local Supabase CLI displays these values in supabase status.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required outside localhost. The trusted reverse proxy must overwrite this header.
TRUSTED_IP_HEADER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server monitoring. No personal data or request bodies are sent.
SENTRY_DSN=
