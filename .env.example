# The local Supabase CLI displays these values in supabase status.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required outside localhost. The trusted reverse proxy must overwrite this header.
TRUSTED_IP_HEADER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server monitoring. No personal data or request bodies are sent.
SENTRY_DSN=

# Optional bearer secret for the scheduled blog publishing worker (32+ characters).
BLOG_CRON_SECRET=

# Private Chromium renderer. Use the same token on both services.
PDF_RENDERER_URL=
PDF_RENDERER_TOKEN=

# Supabase Auth verifies Turnstile. Set the secret for the widget in Supabase.
TURNSTILE_SITE_KEY=

# OpenAI-compatible HTTPS endpoint and the provider's current USD rates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_DAILY_CAP_MICRO_USD=

# Paddle checkout. Use separate sandbox and production credentials.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_STANDARD=
PADDLE_PRICE_LARGE=

# Bearer secret for the maintenance scheduler (32+ characters).
MAINTENANCE_CRON_SECRET=
